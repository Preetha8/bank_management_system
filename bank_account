class Bank:
    def __init__(self,account_number,holder_name,balance):
        self.account_number = account_number
        self.holder_name = holder_name
        self.balance = balance
    def deposit(self,amount):
        self.balance = self.balance + amount
        print('deposit:',amount)
        print('balance:',self.balance)
    def withdraw(self,amount):
        pass
    def check_balance(self):
        print(f'current balance:{self.balance}')
    def display(self):
        print(f'account number:{self.account_number}')
        print(f'holder_name:{self.holder_name}')
        print(f'initial_balance:{self.balance}')
class SavingsAccount(Bank):
    def __init__(self,account_number,account_type,holder_name,balance,):
        self.account_type = account_type
        super().__init__(account_number,holder_name,balance)
    def withdraw(self,amount):
        if amount<=self.balance:
            self.balance = self.balance - amount
            print('withdraw:',amount)
            print('withdrawal successful')
            print('balance:',self.balance)
        else:
            raise ValueError('Insufficient Balance')
    def display(self):
        print(f'account_type:{self.account_type}')
        super().display()

class CurrentAccount(Bank):
    def __init__(self,account_number,account_type,holder_name,balance):
        self.account_type = account_type
        super().__init__(account_number,holder_name,balance)
    def withdraw(self,amount,overdraft_limit=3000):
        if amount <= self.balance + overdraft_limit:
            self.balance = self.balance - amount
            print('withdraw:', amount)
            print('withdrawal successful')
            print('balance:',self.balance)
        else:
            print('Withdrawal failed')
            print('Overdraft limit exceeded')

    def display(self):
        print(f'account_type:{self.account_type}')
        super().display()
